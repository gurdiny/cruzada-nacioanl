{
  "$schema": "node_modules/wrangler/config-schema.json",

  // El nombre tiene que coincidir con el Worker que ya existe en Cloudflare,
  // o el deploy crearía uno nuevo en otra URL.
  "name": "cruzada-nacioanl",
  "compatibility_date": "2026-09-26",

  "observability": {
    "enabled": true
  },

  // Sitio estático: no hay código de Worker, solo archivos.
  // "." es la raíz del repo, así que lo que NO debe publicarse va en
  // .assetsignore (empezando por .git, que es lo que rompía el build).
  "assets": {
    "directory": ".",

    // Sirve /index.html en la raíz y quita el .html de las URLs.
    "html_handling": "auto-trailing-slash",

    // "none" = un archivo que falta devuelve 404 de verdad.
    //
    // Estuvo en "single-page-application" y fue un error: esa opción hace
    // que CUALQUIER ruta inexistente responda 200 con el index.html. Un
    // .webp que faltaba devolvía 200 + text/html, el navegador intentaba
    // decodificar HTML como imagen y la foto salía en blanco, mientras que
    // comprobarlo con HEAD decía 200 y parecía estar bien. La página no
    // tiene enrutado por URL (navega por scroll), así que el respaldo SPA
    // no aportaba nada y solo escondía los fallos.
    "not_found_handling": "none"
  }
}
